@model RaceDayMVC.Models.CategoryViewModel
@{
    ViewData["Title"] = "Create Category";
}
<div class="container mt-4">
    <h2>Create Category</h2>
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="EventID" class="form-label">Event ID</label>
            <input asp-for="EventID" type="number" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label"></label>
            <input asp-for="CategoryName" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="AgeMinimum" class="form-label">Minimum Age</label>
            <input asp-for="AgeMinimum" type="number" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="AgeMaximum" class="form-label">Maximum Age</label>
            <input asp-for="AgeMaximum" type="number" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Distance" class="form-label">Distance (km)</label>
            <input asp-for="Distance" type="number" step="0.01" class="form-control" />
        </div>
        <button class="btn btn-dark">Create Category</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>