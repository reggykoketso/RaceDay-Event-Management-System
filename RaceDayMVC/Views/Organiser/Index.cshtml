@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-5">
    <h1>Welcome to RaceDay!</h1>
    <p class="text-muted">Organiser Dashboard</p>

    <div class="alert alert-primary">
        Welcome back, @ViewBag.UserEmail!
    </div>

    <div class="row g-4 mt-2">
        <div class="col-md-4">
            <div class="card shadow p-4 h-100">
                <h4>Manage Events</h4>
                <p>Create, update and manage race events.</p>
                <a asp-controller="Organiser" asp-action="Events"
                   class="btn btn-dark">Manage Events</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow p-4 h-100">
                <h4>Enrolments</h4>
                <p>View and manage participant enrolments.</p>
                <a asp-controller="Organiser" asp-action="Enrolments"
                   class="btn btn-dark">View Enrolments</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow p-4 h-100">
                <h4>Race Results</h4>
                <p>Enter and publish race results.</p>
                <a asp-controller="Organiser" asp-action="Results"
                   class="btn btn-dark">Manage Results</a>
            </div>
        </div>
    </div>
</div>
