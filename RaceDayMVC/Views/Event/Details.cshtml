@model RaceDayMVC.Models.EventViewModel

@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-4">
    <div class="card shadow p-4">
        <h2>@Model.Name</h2>

        <hr />

        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Event Date:</strong> @Model.EventDate.ToString("dd MMMM yyyy HH:mm")</p>
        <p><strong>Location:</strong> @Model.Location</p>
        <p><strong>Distance:</strong> @Model.Distance km</p>
        <p><strong>Event Type:</strong> @Model.EventType</p>

        <a asp-action="Index" class="btn btn-dark mt-3">
            Back to Events
        </a>
    </div>
</div>