@model RaceDayMVC.Models.EventViewModel

@{
    ViewData["Title"] = "Event Details";

    var userRole = Context.Session.GetString("UserRole");
    var userId = Context.Session.GetString("UserID");
    var isParticipant = userRole == "Participant"
                        && !string.IsNullOrEmpty(userId);
    var isOrganiser = userRole == "Organiser"
                      && !string.IsNullOrEmpty(userId);
}

<div class="container mt-4">

    <div class="card shadow p-4">

        <h2 class="fw-bold">@Model.Name</h2>

        <hr />

        <p><strong>Description:</strong> @Model.Description</p>

        <p>
            <strong>Event Date:</strong>
            @Model.EventDate.ToString("dd MMMM yyyy HH:mm")
        </p>

        <p><strong>Location:</strong> @Model.Location</p>

        <p><strong>Distance:</strong> @Model.Distance km</p>

        <p><strong>Event Type:</strong> @Model.EventType</p>

        <hr />

        @if (isParticipant)
        {
            <a asp-controller="Enrolment"
               asp-action="Create"
               class="btn btn-success btn-lg w-100 mb-3">
                Enrol Now
            </a>
        }
        else if (isOrganiser)
        {
            <div class="alert alert-info">
                You are logged in as an Organiser.
                Participants can enrol in this event.
            </div>
        }
        else
        {
            <a asp-controller="Auth"
               asp-action="Login"
               class="btn btn-success btn-lg w-100 mb-3">
                Login to Enrol
            </a>
        }

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-dark">
            Back to Home
        </a>

    </div>

</div>
