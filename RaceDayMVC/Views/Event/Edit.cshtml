@model RaceDayMVC.Models.EventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-4">
    <div class="card shadow p-4">
        <h2>Edit Event</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form asp-action="Edit" asp-route-id="@Model.EventID" method="post">
            <input type="hidden" asp-for="EventID" />
            <input type="hidden" asp-for="OrganiserId" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Event Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="EventDate" class="form-label">Event Date</label>
                <input asp-for="EventDate"
                       type="datetime-local"
                       value="@Model.EventDate.ToString("yyyy-MM-ddTHH:mm")"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Location" class="form-label">Location</label>
                <input asp-for="Location" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Distance" class="form-label">Distance (km)</label>
                <input asp-for="Distance" type="number" step="0.01" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="EventType" class="form-label">Event Type</label>
                <select asp-for="EventType" class="form-select">
                    <option value="Run">Run</option>
                    <option value="Walk">Walk</option>
                    <option value="Marathon">Marathon</option>
                    <option value="Trail Run">Trail Run</option>
                    <option value="Cycling">Cycling</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>