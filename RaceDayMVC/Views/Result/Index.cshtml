@model List<RaceDayMVC.Models.ResultViewModel>

@{
    ViewData["Title"] = "Race Results";
}

<div class="container mt-4">
    <h2>Race Results</h2>
    <p class="text-muted">View race finishing times and positions.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (ViewBag.IsOrganiser == true)
    {
        <a asp-action="Create" class="btn btn-success mb-3">
            Add New Result
        </a>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No race results are available yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Participant ID</th>
                        <th>Event</th>
                        <th>Category</th>
                        <th>Finish Time</th>
                        <th>Position</th>
                        @if (ViewBag.IsOrganiser == true)
                        {
                            <th>Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderBy(r => r.FinishPosition))
                    {
                        <tr>
                            <td>@item.ParticipantID</td>
                            <td>@item.EventName</td>
                            <td>@item.CategoryName</td>
                            <td>@item.FinishTime</td>
                            <td>@item.FinishPosition</td>

                            @if (ViewBag.IsOrganiser == true)
                            {
                                <td>
                                    <a asp-action="Edit"
                                       asp-route-id="@item.ResultID"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.ResultID"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete this result?');">
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Home" asp-action="Index"
       class="btn btn-secondary mt-2">
        Back Home
    </a>
</div>
