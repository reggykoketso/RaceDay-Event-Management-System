@model List<RaceDayMVC.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">
    <h2>My Enrolments</h2>
    <p>View the events you have registered for.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <a asp-action="Create" class="btn btn-primary mb-3">
        Enrol for an Event
    </a>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You have not enrolled in any events yet.
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Category</th>
                    <th>Enrolment Date</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var enrolment in Model)
                {
                    <tr>
                        <td>@enrolment.EventName</td>
                        <td>@enrolment.CategoryName</td>
                        <td>@enrolment.EnrolmentDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <form asp-action="Cancel"
                                  asp-route-id="@enrolment.EnrolmentID"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to cancel this enrolment?');">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    Cancel
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>