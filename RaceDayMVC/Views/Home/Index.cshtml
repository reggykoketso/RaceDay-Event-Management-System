@model List<RaceDayMVC.Models.Event>

@{
    ViewData["Title"] = "Home";
}

<div class="container mt-4">

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Welcome to RaceDay</h1>

        <p class="lead">
            Your platform for managing, discovering and participating
            in exciting running events.
        </p>

        <p>
            Register for events, explore race categories and track race results.
        </p>
    </div>

    <div class="row text-center mb-5">

        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm p-3">
                <h4>Discover Events</h4>
                <p>Explore available running events and find your next challenge.</p>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm p-3">
                <h4>Explore Categories</h4>
                <p>Find race categories that match your interests and abilities.</p>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm p-3">
                <h4>Race Results</h4>
                <p>Keep track of finishing times and race positions.</p>
            </div>
        </div>

    </div>

    <hr />

    <h2 class="text-center mb-4">Upcoming Events</h2>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-warning">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row">

            @foreach (var raceEvent in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h5 class="card-title">
                                @raceEvent.Name
                            </h5>

                            <p class="card-text">
                                @raceEvent.Description
                            </p>

                            <p>
                                <strong>Date:</strong>
                                @raceEvent.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @raceEvent.Location
                            </p>

                            <p>
                                <strong>Distance:</strong>
                                @raceEvent.Distance km
                            </p>

                            <p>
                                <strong>Event Type:</strong>
                                @raceEvent.EventType
                            </p>

                            <a asp-controller="Event"
                               asp-action="Details"
                               asp-route-id="@raceEvent.EventID"
                               class="btn btn-primary w-100">
                                View Event Details
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            No upcoming events are available at the moment.
        </div>
    }

</div>
