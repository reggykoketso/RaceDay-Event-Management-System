```cshtml
@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-5">
    <h1>Welcome to RaceDay!</h1>
    <p class="text-muted">Participant Dashboard</p>

    <div class="alert alert-primary">
        Welcome back, @ViewBag.UserEmail!
    </div>

    <div class="row g-4 mt-2">

        <div class="col-md-4">
            <div class="card shadow p-4 h-100">
                <h4>Upcoming Events</h4>
                <p>Discover upcoming races and events.</p>
                <a asp-controller="Event" asp-action="Index"
                   class="btn btn-dark">Browse Events</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow p-4 h-100">
                <h4>My Enrolments</h4>
                <p>View your event enrolments and their status.</p>
                <a asp-controller="Enrolment" asp-action="Index"
                   class="btn btn-dark">My Enrolments</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow p-4 h-100">
                <h4>My Results</h4>
                <p>View your race results and finishing positions.</p>
                <a asp-controller="Result" asp-action="Index"
                   class="btn btn-dark">My Results</a>
            </div>
        </div>

    </div>
</div>
```