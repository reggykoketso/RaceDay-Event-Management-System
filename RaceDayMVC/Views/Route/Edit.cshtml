@model RaceDayMVC.Models.RouteViewModel
@{
    ViewData["Title"] = "Edit Route";
}
<div class="container mt-4">
    <h2>Edit Route</h2>
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form asp-action="Edit" asp-route-id="@Model.RouteID" method="post">
        <input type="hidden" asp-for="RouteID" />
        <div class="mb-3">
            <label asp-for="EventID" class="form-label">Event ID</label>
            <input asp-for="EventID" type="number" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="RouteName" class="form-label">Route Name</label>
            <input asp-for="RouteName" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="StartLocation" class="form-label">Start Location</label>
            <input asp-for="StartLocation" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="FinishLocation" class="form-label">Finish Location</label>
            <input asp-for="FinishLocation" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Distance" class="form-label">Distance (km)</label>
            <input asp-for="Distance" type="number" step="0.01" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="RouteDescription" class="form-label">Description</label>
            <textarea asp-for="RouteDescription" class="form-control"></textarea>
        </div>
        <button class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>